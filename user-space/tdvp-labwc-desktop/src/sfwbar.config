#Api2

# The desktop uses two Labwc-compatible SFWBar panels. The top panel is for
# session state; the bottom panel is the touch-friendly XDG launcher and
# live Wayland task dock.
Set ImagePath = "icons/misc"
Set ThicknessHint = "70px"

include "winops.widget"
include "session.widget"
include "network.widget"
include "clock.widget"

bar "tdvp-status" {
  edge = "top"
  layer = "top"
  monitor = "static:DSI-1"
  exclusive_zone = "auto"

  label {
    css = "* { -GtkWidget-hexpand: true; }"
  }

  widget "network.widget"

  widget "session.widget" {
    session_actions = [
      ["system-log-out", "Log out", "loginctl terminate-user $USER"],
      ["system-reboot", "Restart", "systemctl reboot"],
      ["system-shutdown", "Power off", "systemctl poweroff"]
    ];
  }

  widget "clock.widget" {
    disable = false
    time_format = "%H:%M"
    tooltip_format = "%H:%M\\n%x"
    week_starts_on_sunday = false
    reset_on_popup = false
  }
}

bar "tdvp-dock" {
  edge = "bottom"
  layer = "top"
  monitor = "static:DSI-1"
  exclusive_zone = "auto"

  widget "tdvp-launcher.widget"

  taskbar {
    style = "tdvp-dock-taskbar"
    rows = 1
    tooltips = true
    icons = true
    labels = true
    title_width = 22
    sort = true
    css = "* { -GtkWidget-hexpand: true; }"
    action[RightClick] = Menu("winops")
    action[MiddleClick] = Close()
    action[Drag] = Focus()
  }
}

#CSS
window#tdvp-status {
  background-color: #f4f0e6;
  border-bottom: 2px solid #2a2a2a;
  box-shadow: inset 0 -6px #e66a2c;
  padding-left: 28px;
  padding-right: 28px;
}

window#tdvp-dock {
  background-color: #f4f0e6;
  border-top: 2px solid #2a2a2a;
  box-shadow: inset 0 6px #e66a2c;
  padding-left: 24px;
  padding-right: 24px;
}

button,
button image {
  min-height: 0px;
  outline-style: none;
  box-shadow: none;
  background-image: none;
  border-image: none;
}

label {
  font-family: "DejaVu Sans Mono";
  font-size: calc(@bar_thickness * 0.36);
  color: #171717;
}

/* The panel is also a touch target on the 1232x568 K230 display. */
image {
  color: #171717;
  -ScaleImage-symbolic: true;
}

.module image,
button#tdvp-launcher image,
button#module image {
  padding: 0px;
  margin: 0px;
  min-width: calc(@bar_thickness * 0.56);
  min-height: calc(@bar_thickness * 0.56);
  -GtkWidget-valign: center;
  -GtkWidget-vexpand: true;
}

button#taskbar_item image {
  padding: 0px;
  margin: 0px;
  min-width: calc(@bar_thickness * 0.46);
  min-height: calc(@bar_thickness * 0.46);
  -GtkWidget-valign: center;
}

.module,
button#tdvp-launcher,
button#module,
button#taskbar_item {
  background-color: transparent;
  border: 0;
  border-radius: 0px;
  box-shadow: none;
  padding: calc(@bar_thickness * 0.16);
  margin: 0px;
}

button#tdvp-launcher {
  background-color: #efe8d9;
  border-right: 2px solid #2a2a2a;
  min-width: 94px;
}

window#tdvp-dock button#tdvp-launcher {
  background-color: #efe8d9;
  border: 0;
  border-right: 2px solid #2a2a2a;
  min-width: 86px;
  margin: 0px 10px 0px 0px;
}

button#taskbar_item {
  border-left: 1px solid #bbb19e;
  margin: 8px 0px;
  padding: 0px calc(@bar_thickness * 0.22);
}

window#tdvp-dock button#taskbar_item {
  min-width: 108px;
  background-color: transparent;
  border: 0;
  border-right: 1px solid #bbb19e;
  margin: 0px 5px;
  padding: 0px calc(@bar_thickness * 0.18);
}

.module:hover,
button#tdvp-launcher:hover,
button#module:hover,
button#taskbar_item:hover,
.focused {
  background-color: #e66a2c;
  color: #171717;
  box-shadow: inset 0 -7px #2a2a2a;
}

menu,
.menu {
  background-color: #f4f0e6;
  border: 2px solid #2a2a2a;
  border-radius: 0;
  box-shadow: 4px 4px #bdb5a4;
}

menuitem {
  color: #171717;
  font-family: "DejaVu Sans Mono";
  font-size: 22px;
  min-height: 52px;
  padding: 4px 18px;
}

menuitem:hover,
menuitem:focus {
  background-color: #e66a2c;
  color: #171717;
}
