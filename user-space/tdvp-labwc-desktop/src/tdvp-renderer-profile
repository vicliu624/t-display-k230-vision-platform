#!/bin/sh
set -eu

# Renderer selection is deliberately a session-start decision.  A wlroots
# renderer owns textures, output buffers and render passes, so changing it in
# the middle of a frame is not a safe failure-recovery mechanism.  Keep the
# product exclusively on the pinned VGLite stack, require an image-owned enable
# policy, and use a per-user circuit breaker after an abnormal VGLite session
# exit. The enable policy is not a record of hardware acceptance.
profile_file="${TDVP_RENDERER_PROFILE_FILE:-/etc/tdvp/labwc/renderer-profile}"
vglite_enabled_file="${TDVP_VGLITE_ENABLED_FILE:-/etc/tdvp/labwc/vglite-enabled}"
state_root="${TDVP_RENDERER_STATE_DIR:-${XDG_STATE_HOME:-${HOME:-/home/tdvp}/.local/state}/tdvp-labwc}"
failure_file="${TDVP_VGLITE_FAILURE_FILE:-${state_root}/vglite.failed}"
# A diagnostic capture is intentionally user-session state rather than an
# image-wide environment assignment. The session launcher consumes the marker
# before starting Labwc, so verbose renderer logging can never accidentally
# become the default after a reboot or a later login.
diagnostics_file="${TDVP_VGLITE_DIAGNOSTICS_FILE:-/home/tdvp/.local/state/tdvp-labwc/vglite-diagnostics-next-session}"
diagnostics_owner="${TDVP_VGLITE_DIAGNOSTICS_OWNER:-tdvp:tdvp}"

usage() {
	printf '%s\n' "usage: $0 {resolve|status|trip STATUS|select vglite|clear-vglite-failure|diagnostics-status|diagnostics-next-vglite-session|clear-diagnostics-next-vglite-session}" >&2
}

configured_profile() {
	profile="unavailable"

	# Do not source the policy file: the parser intentionally accepts only the
	# one supported assignment. Missing, duplicate or unsupported policy must
	# block the desktop, never select a software renderer or execute shell code.
	if [ -r "${profile_file}" ]; then
		while IFS= read -r line || [ -n "${line}" ]; do
			case "${line}" in
				''|\#*) ;;
				TDVP_RENDERER_PROFILE=vglite)
					if [ "${profile}" != unavailable ]; then
						printf '%s\n' invalid
						return
					fi
					profile=vglite ;;
				*) printf '%s\n' invalid; return ;;
			esac
		done < "${profile_file}"
	fi

	printf '%s\n' "${profile}"
}

effective_profile() {
	profile="$(configured_profile)"

	if [ "${profile}" != vglite ] ||
		! grep -Fqx 'tdvp_vglite_policy_version=1' "${vglite_enabled_file}" 2>/dev/null ||
		[ -e "${failure_file}" ]; then
		printf '%s\n' 'tdvp-renderer-profile: desktop blocked; require valid VGLite policy and a clear failure marker (no renderer fallback)' >&2
		return 1
	fi
	printf '%s\n' vglite
}

require_root() {
	if [ "$(id -u)" != 0 ]; then
		printf '%s\n' "tdvp-renderer-profile: this action requires root" >&2
		exit 1
	fi
}

write_profile() {
	profile="$1"
	directory="$(dirname "${profile_file}")"
	temporary="${profile_file}.tmp.$$"

	mkdir -p "${directory}"
	(
		umask 022
		printf '%s\n' "TDVP_RENDERER_PROFILE=${profile}" > "${temporary}"
	)
	chmod 0644 "${temporary}"
	mv -f "${temporary}" "${profile_file}"
}

trip_vglite() {
	status="$1"
	directory="$(dirname "${failure_file}")"
	temporary="${failure_file}.tmp.$$"

	case "${status}" in
		''|*[!0-9]*)
			printf '%s\n' "tdvp-renderer-profile: STATUS must be numeric" >&2
			exit 1
			;;
	esac

	mkdir -p "${directory}"
	chmod 0700 "${directory}"
	(
		umask 077
		printf 'renderer=vglite\n'
		printf 'exit_status=%s\n' "${status}"
		printf 'recorded_epoch=%s\n' "$(date +%s)"
	) > "${temporary}"
	chmod 0600 "${temporary}"
	mv -f "${temporary}" "${failure_file}"
}

arm_vglite_diagnostics_once() {
	directory="$(dirname "${diagnostics_file}")"
	temporary="${diagnostics_file}.tmp.$$"

	# The graphical user consumes this marker before exec'ing Labwc. Keep the
	# directory private to that user and make the hand-off explicit: a root-only
	# management command creates a tdvp-owned, one-shot file instead of leaving
	# a root-owned file that the session cannot safely remove.
	mkdir -p "${directory}"
	chown "${diagnostics_owner}" "${directory}"
	chmod 0700 "${directory}"
	(
		umask 077
		: > "${temporary}"
	)
	chown "${diagnostics_owner}" "${temporary}"
	chmod 0600 "${temporary}"
	mv -f "${temporary}" "${diagnostics_file}"
}

command="${1:-}"
case "${command}" in
	resolve)
		[ "$#" -eq 1 ] || { usage; exit 1; }
		effective_profile
		;;
	status)
		[ "$#" -eq 1 ] || { usage; exit 1; }
		configured="$(configured_profile)"
		effective="$(effective_profile 2>/dev/null)" || effective=blocked
		if [ -f "${vglite_enabled_file}" ]; then
			enabled=yes
		else
			enabled=no
		fi
		if [ -e "${failure_file}" ]; then
			breaker=tripped
		else
			breaker=clear
		fi
		printf 'configured=%s effective=%s vglite_enabled=%s breaker=%s\n' \
			"${configured}" "${effective}" "${enabled}" "${breaker}"
		;;
	trip)
		[ "$#" -eq 2 ] || { usage; exit 1; }
		trip_vglite "$2"
		;;
	select)
		[ "$#" -eq 2 ] || { usage; exit 1; }
		require_root
		case "$2" in
			vglite)
				if ! grep -Fqx 'tdvp_vglite_policy_version=1' "${vglite_enabled_file}" 2>/dev/null; then
					printf '%s\n' "tdvp-renderer-profile: VGLite is not approved in this image" >&2
					exit 1
				fi
				write_profile vglite
				;;
			*)
				usage
				exit 1
				;;
		esac
		;;
	clear-vglite-failure)
		[ "$#" -eq 1 ] || { usage; exit 1; }
		require_root
		rm -f "${failure_file}"
		;;
	diagnostics-status)
		[ "$#" -eq 1 ] || { usage; exit 1; }
		if [ -f "${diagnostics_file}" ]; then
			printf '%s\n' next-vglite-session
		else
			printf '%s\n' off
		fi
		;;
	diagnostics-next-vglite-session)
		[ "$#" -eq 1 ] || { usage; exit 1; }
		require_root
		arm_vglite_diagnostics_once
		;;
	clear-diagnostics-next-vglite-session)
		[ "$#" -eq 1 ] || { usage; exit 1; }
		require_root
		rm -f "${diagnostics_file}"
		;;
	*)
		usage
		exit 1
		;;
esac
