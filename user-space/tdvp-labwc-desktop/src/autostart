#!/bin/sh

# Labwc has opened the DRM backend before this standard XDG autostart hook is
# evaluated. Keep the board-validated output transform in the session layer.
attempt=0
while [ "$attempt" -lt 40 ]; do
	if /usr/bin/wlr-randr --output "$TDVP_K230_OUTPUT" \
		--transform "$TDVP_K230_OUTPUT_TRANSFORM"; then
		break
	fi
	attempt=$((attempt + 1))
	sleep 0.05
done

# PCManFM creates the background layer, desktop icons and conventional
# right-click desktop menu. Its configuration keeps the existing TDVP paper
# artwork and does not alter the board-validated Labwc output mapping above.
/usr/local/bin/tdvp-pcmanfm-desktop-session &

# Raspberry Pi's volumepulse plugin talks to a per-desktop-user PulseAudio
# server.  Start and wait for that upstream server before the panel is loaded;
# the SDK's system-wide daemon authenticates only its `pulse` account and made
# the volume component disappear for the logged-in `tdvp` desktop user.
/usr/local/bin/tdvp-pulseaudio-session

# Keep one deliberately compact top panel. wf-panel-pi is the maintained
# Raspberry Pi desktop panel host; its TDVP system configuration preserves our
# warm-paper/orange visual language rather than importing Raspberry Pi styling.
/usr/local/bin/tdvp-wf-panel-session &

# Board-level key policy: the TCA8418 Menu key opens or closes Raspberry Pi's
# existing smenu component through its documented wfpanelctl command.
# It is a proper Wayland surface, unlike the currently affected GTK3 panel popup.
/usr/local/bin/tdvp-key-bridge &
