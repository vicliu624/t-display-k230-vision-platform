#!/bin/sh
set -eu

# wfplug-volumepulse is an upstream Raspberry Pi panel component.  It needs a
# normal user-session PulseAudio socket and its matching cookie; the Buildroot
# system daemon uses the separate `pulse` account and rejects the desktop
# user's client authentication.
if [ -z "${HOME:-}" ] || [ ! -d "${HOME}" ]; then
	echo "tdvp-pulseaudio: HOME is unavailable" >&2
	exit 1
fi
export XDG_RUNTIME_DIR="${XDG_RUNTIME_DIR:-${HOME}/.cache/wayland-runtime}"
export PULSE_SERVER="unix:${XDG_RUNTIME_DIR}/pulse/native"

start_supervisor() {
	# The ALSA sink runs in PulseAudio's I/O thread.  If that thread ever exits,
	# keep the desktop's authenticated server contract intact by restarting the
	# per-user daemon with a bounded backoff.  The server stays in the foreground
	# of this private supervisor, while this launcher returns once the socket is
	# available to the panel and ordinary applications.
	(
		delay=1
		while :; do
			/usr/bin/pulseaudio --daemonize=no --exit-idle-time=-1 --log-target=journal &
			server_pid=$!
			wait "$server_pid" || true
			sleep "$delay"
			if [ "$delay" -lt 8 ]; then
				delay=$((delay * 2))
			fi
		done
	) >/dev/null 2>&1 &
}

if ! /usr/bin/pactl info >/dev/null 2>&1; then
	start_supervisor
fi

# Do not launch wf-panel-pi until its volume backend can authenticate.  The
# bounded wait makes first boot deterministic while keeping a broken sound
# server visible in the journal instead of silently rendering a dead widget.
attempt=0
while [ "$attempt" -lt 30 ]; do
	if /usr/bin/pactl info >/dev/null 2>&1; then
		exit 0
	fi
	attempt=$((attempt + 1))
	sleep 0.1
done

echo 'tdvp-pulseaudio: user-session server did not become ready' >&2
exit 1
