<?xml version="1.0"?>
<labwc_config xmlns="https://labwc.github.io/schema/rc-xml">
  <core>
    <decoration>server</decoration>
  </core>
  <theme>
    <!-- Touch targets are provided by Labwc's existing server decoration;
         keep the conventional minimize, maximize, and close controls. -->
    <titlebar>
      <layout>icon:iconify,max,close</layout>
      <showTitle>yes</showTitle>
    </titlebar>
    <maximizedDecoration>titlebar</maximizedDecoration>
  </theme>
  <keyboard>
    <default />
    <keybind key="W-Return">
      <action name="Execute" command="foot" />
    </keybind>
    <keybind key="W-q">
      <action name="Close" />
    </keybind>
    <!-- A fullscreen Wayland client has no visible server close button. Keep
         the normal desktop convention available to every application. -->
    <keybind key="A-F4">
      <action name="Close" />
    </keybind>
    <keybind key="W-m">
      <action name="ToggleMaximize" />
    </keybind>
    <keybind key="W-f">
      <action name="ToggleFullscreen" />
    </keybind>
  </keyboard>
  <mouse>
    <default />
    <context name="Maximize">
      <mousebind button="Left" action="Press">
        <action name="ToggleMaximize" />
      </mousebind>
    </context>
    <context name="Close">
      <mousebind button="Left" action="Press">
        <action name="Close" />
      </mousebind>
    </context>
    <context name="Title">
      <mousebind button="Left" action="DoubleClick">
        <action name="ToggleMaximize" />
      </mousebind>
    </context>
  </mouse>
  <touch>
    <deviceName>Goodix GT9895 Touchscreen</deviceName>
    <mouseEmulation>yes</mouseEmulation>
  </touch>
</labwc_config>
