<?xml version="1.0"?>
<labwc_config xmlns="https://labwc.github.io/schema/rc-xml">
  <core>
    <decoration>server</decoration>
  </core>
  <theme>
    <!-- Touch targets are provided by Labwc's existing server decoration;
         keep the conventional minimize, maximize, and close controls. -->
    <titlebar>
      <layout>icon:iconify,max,close</layout>
      <showTitle>yes</showTitle>
    </titlebar>
    <maximizedDecoration>titlebar</maximizedDecoration>
  </theme>
  <!--
       Workspaces are compositor-owned Labwc state.  Keep the number fixed for
       the small TDVP display so touch edge navigation has a predictable end
       rather than dynamically creating or wrapping desktops.
  -->
  <desktops>
    <number>4</number>
    <prefix>Workspace</prefix>
    <popupTime>550</popupTime>
  </desktops>
  <keyboard>
    <default />
    <!-- Physical keyboard fallback for the same non-wrapping workspace model
         used by the touchscreen edge gesture. -->
    <keybind key="W-Left">
      <action name="GoToDesktop" to="left" wrap="no" />
    </keybind>
    <keybind key="W-Right">
      <action name="GoToDesktop" to="right" wrap="no" />
    </keybind>
    <keybind key="W-S-Left">
      <action name="SendToDesktop" to="left" follow="no" wrap="no" />
    </keybind>
    <keybind key="W-S-Right">
      <action name="SendToDesktop" to="right" follow="no" wrap="no" />
    </keybind>
    <keybind key="W-1">
      <action name="GoToDesktop" to="1" wrap="no" />
    </keybind>
    <keybind key="W-2">
      <action name="GoToDesktop" to="2" wrap="no" />
    </keybind>
    <keybind key="W-3">
      <action name="GoToDesktop" to="3" wrap="no" />
    </keybind>
    <keybind key="W-4">
      <action name="GoToDesktop" to="4" wrap="no" />
    </keybind>
    <keybind key="W-Return">
      <action name="Execute" command="foot" />
    </keybind>
    <keybind key="W-q">
      <action name="Close" />
    </keybind>
    <!-- A fullscreen Wayland client has no visible server close button. Keep
         the normal desktop convention available to every application. -->
    <keybind key="A-F4">
      <action name="Close" />
    </keybind>
    <keybind key="W-m">
      <action name="ToggleMaximize" />
    </keybind>
    <keybind key="W-f">
      <action name="ToggleFullscreen" />
    </keybind>
  </keyboard>
  <mouse>
    <default />
    <context name="Maximize">
      <mousebind button="Left" action="Press">
        <action name="ToggleMaximize" />
      </mousebind>
    </context>
    <context name="Close">
      <mousebind button="Left" action="Press">
        <action name="Close" />
      </mousebind>
    </context>
    <context name="Title">
      <mousebind button="Left" action="DoubleClick">
        <action name="ToggleMaximize" />
      </mousebind>
    </context>
  </mouse>
  <touch>
    <deviceName>Goodix GT9895 Touchscreen</deviceName>
    <mouseEmulation>yes</mouseEmulation>
  </touch>
</labwc_config>
