# GT9895 reports native portrait coordinates. The validated matrix maps them
# to the panel's logical 1232x568 landscape session after the DRM transform.
ACTION=="add|change", SUBSYSTEM=="input", KERNEL=="event*", ATTRS{name}=="Goodix GT9895 Touchscreen", ENV{LIBINPUT_CALIBRATION_MATRIX}="0 -1 1 1 0 0"
