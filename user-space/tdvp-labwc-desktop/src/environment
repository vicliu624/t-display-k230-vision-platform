# DRM/KMS values are the board-validated output contract for the RM69A10 panel.
WLR_BACKENDS=drm,libinput
WLR_DRM_DEVICES=/dev/dri/card0
# K230's vendor DRM driver is not backed by a Mesa DRI driver in this image.
# Use wlroots' native pixman renderer so the compositor never falls back
# through the unavailable canaan-drm EGL path.
WLR_RENDERER=pixman
WLR_DRM_NO_MODIFIERS=1
WLR_RENDERER_ALLOW_SOFTWARE=1
# This image uses a private session D-Bus launched by dbus-run-session, not a
# systemd --user manager.  Labwc otherwise tries to import/unset its activation
# environment through systemctl --user on every compositor start/stop; that
# activation is guaranteed to fail here and can be mistaken for a failed login.
LABWC_UPDATE_ACTIVATION_ENV=0
LIBSEAT_BACKEND=seatd
XDG_SEAT=seat0
# Image-owned administration wrappers live in /usr/local/sbin.  Expose that
# conventional directory to graphical applications and terminals so users can
# use `sudo tdvp-opkg …` instead of spelling out an internal installation path.
PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
XKB_DEFAULT_RULES=evdev
XKB_DEFAULT_MODEL=pc105
XKB_DEFAULT_LAYOUT=us
# us(tdvp) includes the normal US layout and maps the detachable keyboard's
# physical KEY_FN to the printed yellow third level.  Tab remains Tab.
XKB_DEFAULT_VARIANT=tdvp
XKB_DEFAULT_OPTIONS=
TDVP_K230_OUTPUT=DSI-1
TDVP_K230_OUTPUT_TRANSFORM=90
TDVP_LOGICAL_WIDTH=1232
TDVP_LOGICAL_HEIGHT=568
