#!/bin/sh
set -eu

readonly app_dir=/root/app/ai2d_kpu
readonly result_dir=/run/vicliu-pocket-linux-hardware
readonly result_file="$result_dir/kpu-acceptance.pass"
readonly skipped_file="$result_dir/kpu-acceptance.skipped"
readonly enable_flag=/etc/tdvp/kpu/acceptance.enabled

mkdir -p "$result_dir"
rm -f "$result_file" "$skipped_file"

# The vendor sample is a reference probe, not a boot prerequisite.  Its
# tensors are tied to one SDK sample and may not match the runtime payload in
# every image.  Keep boot healthy and make the status explicit until an
# operator opts into this probe.
if [ ! -e "$enable_flag" ]; then
    : > "$skipped_file"
    printf '%s\n' \
        'TDVP KPU acceptance: skipped; create /etc/tdvp/kpu/acceptance.enabled to run the explicit probe'
    exit 0
fi

for device in /dev/k230-gnne /dev/k230-ai2d; do
    if [ ! -c "$device" ]; then
        printf 'TDVP KPU acceptance: required character device is unavailable: %s\n' "$device" >&2
        exit 1
    fi
done

if ! output="$(cd "$app_dir" && ./ai2d_kpu.elf test.kmodel ai2d_input.bin input.bin result.bin 2>&1)"; then
    printf '%s\n' "$output" >&2
    exit 1
fi

printf '%s\n' "$output"
if ! printf '%s\n' "$output" | grep -Fq 'ai2d kpu test pass'; then
    exit 1
fi

touch "$result_file"
