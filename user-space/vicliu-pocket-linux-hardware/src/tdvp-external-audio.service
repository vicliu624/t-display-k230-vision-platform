[Unit]
Description=TDVP external I2S speaker route policy
Wants=sound.target
After=sound.target
Before=greetd.service

[Service]
Type=oneshot
ExecStart=/usr/local/bin/tdvp-audio-route external
ExecStop=-/usr/local/bin/tdvp-audio-route internal
RemainAfterExit=yes

[Install]
WantedBy=multi-user.target
