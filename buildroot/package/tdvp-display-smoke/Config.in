config BR2_PACKAGE_TDVP_DISPLAY_SMOKE
	bool "tdvp-display-smoke"
	depends on BR2_TOOLCHAIN_HAS_THREADS
	select BR2_PACKAGE_LIBDRM
	help
	  Install the TDVP board bring-up display smoke test.

	  This is a validation-only target tool. It opens DRM/KMS directly to
	  prove that the minimal Linux image can light the onboard display.
	  It is not part of the public BSP, runtime, SDK, or application API.

comment "tdvp-display-smoke needs a toolchain w/ threads"
	depends on !BR2_TOOLCHAIN_HAS_THREADS
