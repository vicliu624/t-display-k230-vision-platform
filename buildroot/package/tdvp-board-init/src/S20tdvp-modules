#!/bin/sh

case "$1" in
	start)
		echo "Loading TDVP board modules..."
		if command -v tdvp-k230-iomux >/dev/null 2>&1; then
			tdvp-k230-iomux keyboard || \
				echo "tdvp-modules: keyboard IOMUX preset failed"
		fi
		for module in goodix_ts 8189fs; do
			modprobe "$module" 2>/dev/null || \
				echo "tdvp-modules: ${module} not loaded"
		done
		# The K230 Ethernet MAC is named enu1 by the 6.6.36 SDK kernel.
		# Keep eth0 as a compatibility fallback for alternate DTBs.
		for iface in enu1 eth0; do
			if [ -e "/sys/class/net/${iface}" ]; then
				ip link set "${iface}" up 2>/dev/null || true
				udhcpc -i "${iface}" -n -q -t 5 \
					-p "/run/udhcpc-${iface}.pid" \
					>"/var/log/tdvp-${iface}-udhcpc.log" 2>&1 &
				break
			fi
		done
		;;
	stop)
		;;
	restart|reload)
		"$0" start
		;;
	*)
		echo "Usage: $0 {start|stop|restart}"
		exit 1
		;;
esac

exit 0
