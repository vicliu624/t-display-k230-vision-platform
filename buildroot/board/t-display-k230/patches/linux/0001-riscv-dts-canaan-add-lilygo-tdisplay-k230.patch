From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: TDVP Maintainers <tdvp@example.invalid>
Date: Thu, 16 Jul 2026 00:00:00 +0800
Subject: [PATCH] riscv: dts: canaan: add LilyGO T-Display K230

Add a first-pass board device tree for the LilyGO T-Display K230.  This
keeps the known-good K230 Linux SDK baseline but replaces the CanMV LCD
and touch assumptions with the T-Display K230 hardware facts extracted
from the LilyGO RT-Smart reference:

- RM69A10 568x1232 AMOLED over 2-lane MIPI DSI
- GT9895-compatible Goodix touch controller on I2C3 at 0x5d
- RTL8189FTV WiFi on SDIO0
- SD-card rootfs on SDIO1
- I2C4 enabled for keyboard and board capability probing

The TCA8418 keyboard is intentionally not described as a Linux input
node yet because the upstream driver requires an IRQ, while the LilyGO
reference polls the controller over I2C4 and does not provide a verified
IRQ line.  TDVP validates that path with a separate smoke-test tool.
---
 arch/riscv/boot/dts/canaan/display-rm69a10-568x1232.dtsi |  67 +++++++
 arch/riscv/boot/dts/canaan/tdisplay-k230.dts             | 110 +++++++++++
 2 files changed, 177 insertions(+)
 create mode 100644 arch/riscv/boot/dts/canaan/display-rm69a10-568x1232.dtsi
 create mode 100644 arch/riscv/boot/dts/canaan/tdisplay-k230.dts

diff --git a/arch/riscv/boot/dts/canaan/display-rm69a10-568x1232.dtsi b/arch/riscv/boot/dts/canaan/display-rm69a10-568x1232.dtsi
new file mode 100644
index 000000000000..111111111111
--- /dev/null
+++ b/arch/riscv/boot/dts/canaan/display-rm69a10-568x1232.dtsi
@@ -0,0 +1,67 @@
+// SPDX-License-Identifier: GPL-2.0
+
+&vo {
+	vth_line = <10>;
+};
+
+&dsi {
+	ports {
+		port@1 {
+			reg = <1>;
+			dsi_out_rm69a10: endpoint {
+				remote-endpoint = <&rm69a10_in>;
+			};
+		};
+	};
+
+	lcd: panel@0 {
+		compatible = "canaan,universal";
+		reg = <0>;
+
+		panel-width-mm = <568>;
+		panel-height-mm = <1232>;
+		panel-dsi-lane = <2>;
+
+		panel-init-sequence = [
+			39 00 02 fe fd
+			39 00 02 80 fc
+			39 00 02 fe 00
+			39 00 05 2a 00 00 02 37
+			39 00 05 2b 00 00 04 cf
+			39 00 05 31 00 03 02 34
+			39 00 05 30 00 00 04 cf
+			39 00 02 12 00
+			39 00 02 35 00
+			39 02 02 51 fe
+			39 78 01 11
+			39 00 01 29
+			39 00 02 3a 77
+		];
+
+		display-timings {
+			timing-0 {
+				clock-frequency = <39600000>;
+				hactive = <568>;
+				vactive = <1232>;
+				hfront-porch = <40>;
+				hback-porch = <140>;
+				hsync-len = <40>;
+				vfront-porch = <16>;
+				vback-porch = <16>;
+				vsync-len = <4>;
+			};
+		};
+
+		ports {
+			#address-cells = <1>;
+			#size-cells = <0>;
+
+			port@0 {
+				reg = <0>;
+				rm69a10_in: endpoint {
+					remote-endpoint = <&dsi_out_rm69a10>;
+				};
+			};
+		};
+	};
+};
diff --git a/arch/riscv/boot/dts/canaan/tdisplay-k230.dts b/arch/riscv/boot/dts/canaan/tdisplay-k230.dts
new file mode 100644
index 000000000000..222222222222
--- /dev/null
+++ b/arch/riscv/boot/dts/canaan/tdisplay-k230.dts
@@ -0,0 +1,110 @@
+// SPDX-License-Identifier: GPL-2.0 OR MIT
+
+#include "k230.dtsi"
+#include "display-rm69a10-568x1232.dtsi"
+
+/ {
+	model = "LILYGO T-Display K230";
+	compatible = "lilygo,t-display-k230", "canaan,kendryte-k230";
+
+	aliases {
+		serial3 = &uart3;
+		mmc0 = &mmc_sd0;
+		mmc1 = &mmc_sd1;
+		i2c0 = &i2c4;
+		i2c1 = &i2c3;
+	};
+
+	chosen {
+		stdout-path = "serial0:115200n8";
+	};
+
+	ddr: memory@0 {
+		device_type = "memory";
+		reg = <0x0 0x0 0x0 0x40000000>;
+	};
+
+	sound {
+		status = "okay";
+		compatible = "canaan,k230-audio-inno";
+		canaan,model = "K230_I2S_INNO";
+		canaan,k230-i2s-controller = <&i2s>;
+		canaan,k230-audio-codec = <&inno_codec>;
+	};
+};
+
+&uart0 {
+	status = "okay";
+};
+
+&uart3 {
+	status = "okay";
+};
+
+&mmc_sd1 {
+	status = "okay";
+	no-1-8-v;
+	cap-sd-highspeed;
+	mshc_ctrl_r = <0x00>;
+};
+
+&usb0 {
+	status = "okay";
+};
+
+&usb1 {
+	status = "okay";
+};
+
+&i2c3 {
+	status = "okay";
+
+	touchscreen@5d {
+		/*
+		 * The board reference names the controller GT9895.  The
+		 * 6.6.36 baseline does not have a gt9895 compatible string,
+		 * so use the closest Goodix GT9xx Linux path for bring-up.
+		 */
+		compatible = "goodix,gt928";
+		reg = <0x5d>;
+		interrupt-parent = <&gpio0_ports>;
+		interrupts = <23 IRQ_TYPE_EDGE_FALLING>;
+		irq-gpios = <&gpio0_ports 23 GPIO_ACTIVE_HIGH>;
+		reset-gpios = <&gpio0_ports 24 GPIO_ACTIVE_LOW>;
+		touchscreen-size-x = <568>;
+		touchscreen-size-y = <1232>;
+	};
+};
+
+&i2c4 {
+	status = "okay";
+
+	/*
+	 * LilyGO's keyboard demo polls a TCA8418 at 0x34 on this bus and
+	 * resets it through board pin 43.  Keep the bus enabled here; the
+	 * Linux input node will be added after the IRQ line is verified.
+	 */
+};
+
+&mipi0 {
+	/* Set to CSI2 as in the nearest K230 Linux SDK CanMV profile. */
+	id = <2>;
+	reg = <0x0 0x9000a800 0x0 0x800>;
+	interrupts = <121 IRQ_TYPE_LEVEL_HIGH>;
+	resets = <&sysctl_reset K230_RESET_CSI2_REG_OFFSET K230_RESET_CSI2_TYPE
+		  K230_RESET_CSI2_DONE_BIT K230_RESET_CSI2_ASSERT_BIT>,
+		 <&sysctl_reset K230_RESET_M2_REG_OFFSET K230_RESET_M2_TYPE
+		  K230_RESET_M2_DONE_BIT K230_RESET_M2_ASSERT_BIT>;
+};
+
+&lcd {
+	dsi_reset-gpios = <&gpio0_ports 22 GPIO_ACTIVE_HIGH>;
+	backlight_gpio-gpios = <&gpio0_ports 25 GPIO_ACTIVE_HIGH>;
+};
+
+&mmc_sd0 {
+	status = "okay";
+	no-1-8-v;
+	rx_delay_line = <0x0d>;
+	tx_delay_line = <0xc0>;
+};
-- 
2.45.0
