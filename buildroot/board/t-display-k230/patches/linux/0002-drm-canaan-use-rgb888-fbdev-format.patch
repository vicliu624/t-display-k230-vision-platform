From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: TDVP Maintainers <tdvp@example.invalid>
Date: Fri, 17 Jul 2026 00:00:00 +0800
Subject: [PATCH] drm: canaan: stabilize fbdev console

The K230 DRM driver currently asks DRM's generic fbdev helper for a 32 bpp
framebuffer:

    drm_fbdev_generic_setup(drm_dev, 32)

The helper then selects a 32-bit XRGB-style format.  Canaan OSD planes do
not have a true XRGB8888 mode in this vendor driver.  The only advertised
32-bit mode is ARGB8888, and the OSD programming path writes the same DMA
address to the value and alpha registers.  Treating an XRGB framebuffer as
ARGB therefore makes the upper byte participate as alpha, which is not a
valid console framebuffer contract.

The RGB888 path is already supported by the Canaan OSD plane and validated
on T-Display K230 through the DRM/KMS display smoke test.  Request a 24 bpp
generic fbdev instead, so fbcon uses the known-good RGB888 plane format.

The vendor driver also registers a DRM vblank device, but on the T-Display
K230 DSI panel path no reliable vblank completion is observed by DRM.  Atomic
commits then arm a vblank event and wait until flip_done times out.  Treat this
path as a no-vblank display: skip drm_vblank_init(), avoid vblank on/off calls,
and leave pending events for drm_atomic_helper_fake_vblank().
---
 drivers/gpu/drm/canaan/canaan_crtc.c | 12 ++++++++++--
 drivers/gpu/drm/canaan/canaan_drv.c  |  9 +--------
 2 files changed, 11 insertions(+), 10 deletions(-)

diff --git a/drivers/gpu/drm/canaan/canaan_crtc.c b/drivers/gpu/drm/canaan/canaan_crtc.c
index 111111111111..222222222222 100644
--- a/drivers/gpu/drm/canaan/canaan_crtc.c
+++ b/drivers/gpu/drm/canaan/canaan_crtc.c
@@ -68,1 +68,2 @@ static void canaan_crtc_atomic_enable(struct drm_crtc *crtc,
-	drm_crtc_vblank_on(crtc);
+	if (drm_dev_has_vblank(crtc->dev))
+		drm_crtc_vblank_on(crtc);
@@ -75,7 +76,8 @@ static void canaan_crtc_atomic_disable(struct drm_crtc *crtc,
 	struct canaan_vo *vo = canaan_crtc->vo;
 
 	DRM_DEBUG_DRIVER("Disable the CRTC:%d\n", crtc->base.id);
-	drm_crtc_vblank_off(crtc);
+	if (drm_dev_has_vblank(crtc->dev))
+		drm_crtc_vblank_off(crtc);
 	canaan_vo_disable_crtc(vo, canaan_crtc);
 
 	if (crtc->state->event && !crtc->state->active) {
@@ -98,6 +100,9 @@ static void canaan_crtc_atomic_flush(struct drm_crtc *crtc,
 	canaan_vo_flush_config(vo);
 
 	if (event) {
+		if (crtc->state->no_vblank)
+			return;
+
 		WARN_ON(drm_crtc_vblank_get(crtc) != 0);
 
 		spin_lock_irq(&crtc->dev->event_lock);
diff --git a/drivers/gpu/drm/canaan/canaan_drv.c b/drivers/gpu/drm/canaan/canaan_drv.c
index 555555555555..666666666666 100644
--- a/drivers/gpu/drm/canaan/canaan_drv.c
+++ b/drivers/gpu/drm/canaan/canaan_drv.c
@@ -254,12 +254,6 @@ static int canaan_drm_bind(struct device *dev)
 		goto cleanup_mode_config;
 	}
 
-	ret = drm_vblank_init(drm_dev, drm_dev->mode_config.num_crtc);
-	if (ret) {
-		DRM_DEV_ERROR(dev, "Failed to init vblank\n");
-		goto unbind_all;
-	}
-
 	drm_mode_config_reset(drm_dev);
 	drm_kms_helper_poll_init(drm_dev);
 
@@ -269,7 +264,7 @@ static int canaan_drm_bind(struct device *dev)
 		goto finish_poll;
 	}
 
-	drm_fbdev_generic_setup(drm_dev, 32);
+	drm_fbdev_generic_setup(drm_dev, 24);
 	DRM_DEV_INFO(dev, "Canaan K230 DRM driver register successfully\n");
 
 	return 0;
@@ -278,7 +272,6 @@ static int canaan_drm_bind(struct device *dev)
 finish_poll:
 	drm_kms_helper_poll_fini(drm_dev);
-unbind_all:
 	component_unbind_all(dev, drm_dev);
 cleanup_mode_config:
 	drm_mode_config_cleanup(drm_dev);
 
-- 
2.45.0
