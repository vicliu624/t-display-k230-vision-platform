# T-Display K230 Vision Platform Linux U-Boot environment.
#
# This file is the platform-owned text source for the generated
# output/t_display_k230_vision/images/uboot-env.bin image.
# Buildroot converts it with host uboot-tools/mkenvimage.
#
# The first active baseline follows kendryte/k230_linux_sdk
# buildroot-overlay/board/canaan/k230-soc/default.env and uses the SDK
# OpenSBI fw_jump + Image + k.dtb boot.ext4 flow.
# T-Display-specific console, DTB, and display/touch deltas remain hardware
# validation items.

arch=riscv
autoload=0
baudrate=115200
board=k230
board_name=k230
bootdelay=1
console_port=console=ttyS1,115200
bootargs=root=/dev/mmcblk1p2 loglevel=8 rw rootdelay=4 rootfstype=ext4 console=tty0 console=ttyS0,115200 earlycon=sbi consoleblank=0
cpu=k230
dtb_addr=0xa000000
fdt_high=0xa100000
gatewayip=10.99.105.254
ipaddr=10.99.105.44
kernel_addr=0xc100000
loadaddr=0xc000000
mmc_boot_dev_num=1
netmask=255.255.255.0
ramdisk_addr=0xa100000
serverip=192.168.124.2
vendor=canaan
quick_boot=false
k=Image
kilp32=Image_ilp32
nuttex=nuttx-7000000-uart2.bin
blinux=ext4load mmc ${mmc_boot_dev_num}:1 0x3000000 /fw_jump_add_uboot_head.bin && ext4load mmc ${mmc_boot_dev_num}:1 0x200000 /${k} && ext4load mmc ${mmc_boot_dev_num}:1 0x2200000 /k.dtb && bootm 0x3000000 - 0x2200000;
blinuxilp32=setenv k Image_ilp32 && run blinux;
bnuttx=ext4load mmc ${mmc_boot_dev_num}:1 0x7000000 /${nuttex} && boot_baremetal 0 0x${fileaddr} 0x${filesize};
bootcmd=run blinux;
