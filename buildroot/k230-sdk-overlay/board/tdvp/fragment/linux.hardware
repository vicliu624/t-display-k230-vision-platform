# K230 board hardware exposed to Linux user space.
CONFIG_K230_GNNE_DRIVER=y
CONFIG_K230_AI2D_DRIVER=y
CONFIG_RTC_DRV_K230=y
CONFIG_RTC_HCTOSYS=y
CONFIG_RTC_HCTOSYS_DEVICE="rtc0"
CONFIG_BACKLIGHT_PWM=y
CONFIG_VIDEO_OV5647=y
CONFIG_CHARGER_BQ25890=y
CONFIG_BATTERY_BQ27XXX=y
CONFIG_BATTERY_BQ27XXX_I2C=y
CONFIG_SENSORS_AHT10=y
CONFIG_I2C_CHARDEV=y
CONFIG_SND_SOC=y
CONFIG_SND_SOC_K230_INNO=y
CONFIG_SND_SOC_CANAAN_K230_INNO=y
CONFIG_SND_SOC_CANAAN_K230_AUDIO=y
CONFIG_SPI=y
CONFIG_SPI_MASTER=y
CONFIG_SPI_DESIGNWARE=y
CONFIG_SPI_DW_MMIO=y
CONFIG_SPI_SPIDEV=y
CONFIG_TDVP_RADIO_MUX=y
