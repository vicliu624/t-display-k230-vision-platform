diff --git a/drivers/clk/clk-k230-tdvp-amp.h b/drivers/clk/clk-k230-tdvp-amp.h
new file mode 100644
--- /dev/null
+++ b/drivers/clk/clk-k230-tdvp-amp.h
@@ -0,0 +1,106 @@
+/* SPDX-License-Identifier: GPL-2.0-only */
+/* Included after struct k230_clk_composite. Opt-in CMU/I2C4 ownership only.
+ * Lock order: Linux clock spinlock (IRQs off), then HARDLOCK_GPIO == 0.
+ * The paired RT-Smart early-I2C setup must take this same hardware lock.
+ * Neither side may nest a GPIO operation while holding the hardware lock.
+ */
+#ifndef CLK_K230_TDVP_AMP_H
+#define CLK_K230_TDVP_AMP_H
+
+#define TDVP_CMU_LS_GATE 0x24
+#define TDVP_CMU_UART_I2C_DIV 0x2c
+#define TDVP_CMU_LS_DIV 0x30
+#define TDVP_CMU_I2C4_GATES (BIT(10) | BIT(25))
+#define TDVP_CMU_I2C4_DIV (0x7U << 27)
+
+static bool k230_clk_amp_shared_reg(struct k230_clk_composite *clk, void __iomem *reg)
+{
+	return reg && (reg == clk->base_reg + TDVP_CMU_LS_GATE ||
+		reg == clk->base_reg + TDVP_CMU_UART_I2C_DIV ||
+		reg == clk->base_reg + TDVP_CMU_LS_DIV);
+}
+
+static bool k230_clk_amp_retained_gate(struct k230_clk_composite *clk)
+{
+	return clk->amp_lock_reg && clk->gate_reg == clk->base_reg + TDVP_CMU_LS_GATE &&
+		clk->gate_bit == 0;
+}
+
+static bool k230_clk_amp_fixed_rate(struct k230_clk_composite *clk)
+{
+	return clk->amp_lock_reg && clk->rate_reg == clk->base_reg + TDVP_CMU_LS_DIV &&
+		((clk->rate_div_mask << clk->rate_div_shift) & 0x7U);
+}
+
+static int k230_clk_amp_lock(struct k230_clk_composite *clk, void __iomem *reg)
+{
+	u32 value;
+	int ret;
+
+	if (!clk->amp_lock_reg || !k230_clk_amp_shared_reg(clk, reg))
+		return 0;
+	/* K230 read zero acquires, write zero releases. Never wait forever if
+	 * CPU1 crashed: a timed-out Linux operation must leave CMU untouched.
+	 */
+	ret = readl_poll_timeout_atomic(clk->amp_lock_reg, value, !value, 1, 10000);
+	if (ret)
+		pr_err_ratelimited("K230 CPU1 clock hardlock timeout; write refused\n");
+	else
+		mb();
+	return ret;
+}
+
+static void k230_clk_amp_unlock(struct k230_clk_composite *clk, void __iomem *reg)
+{
+	if (clk->amp_lock_reg && k230_clk_amp_shared_reg(clk, reg)) {
+		mb();
+		writel(0, clk->amp_lock_reg);
+	}
+}
+
+static int k230_clk_amp_setup(struct k230_clk_composite *clk, struct device_node *parent)
+{
+	struct resource res;
+	u32 mask;
+
+	if (!of_property_read_bool(parent, "tdvp,cpu1-i2c4-clock-sharing"))
+		return 0;
+	if (of_address_to_resource(parent, 0, &res) || res.start != 0x91100000 ||
+		resource_size(&res) < 0x34)
+		return -EINVAL;
+	if (!k230_clk_amp_shared_reg(clk, clk->gate_reg) &&
+		!k230_clk_amp_shared_reg(clk, clk->rate_reg) &&
+		!k230_clk_amp_shared_reg(clk, clk->rate_reg_1) &&
+		!k230_clk_amp_shared_reg(clk, clk->mux_reg))
+		return 0;
+	/* Shared divider fields must use one register and no mux. PDM shares
+	 * the gate word but its two divider registers are private to Linux.
+	 */
+	if (k230_clk_amp_shared_reg(clk, clk->mux_reg) ||
+		k230_clk_amp_shared_reg(clk, clk->rate_reg_1) ||
+		(k230_clk_amp_shared_reg(clk, clk->rate_reg) && clk->rate_reg_1))
+		return -EINVAL;
+	if (k230_clk_amp_shared_reg(clk, clk->gate_reg)) {
+		if (clk->gate_reg != clk->base_reg + TDVP_CMU_LS_GATE ||
+			clk->gate_bit >= 32 || clk->gate_bit_reverse ||
+			(BIT(clk->gate_bit) & TDVP_CMU_I2C4_GATES))
+			return -EINVAL;
+	}
+	if (k230_clk_amp_shared_reg(clk, clk->rate_reg)) {
+		if (clk->rate_calc_method != 1 || clk->rate_div_shift >= 32 ||
+			clk->rate_div_mask > (U32_MAX >> clk->rate_div_shift) ||
+			clk->rate_write_enable_bit != 31 || clk->rate_mul_mask)
+			return -EINVAL;
+		mask = clk->rate_div_mask << clk->rate_div_shift;
+		if (clk->rate_reg == clk->base_reg + TDVP_CMU_LS_GATE ||
+			(mask & BIT(31)) ||
+			(clk->rate_reg == clk->base_reg + TDVP_CMU_UART_I2C_DIV &&
+			 (mask & TDVP_CMU_I2C4_DIV)))
+			return -EINVAL;
+	}
+	/* Reuse the GPIO semaphore: no uncoordinated allocation of a new slot. */
+	clk->amp_lock_reg = ioremap(0x911040a0, sizeof(u32));
+	return clk->amp_lock_reg ? 0 : -ENOMEM;
+}
+
+#endif
