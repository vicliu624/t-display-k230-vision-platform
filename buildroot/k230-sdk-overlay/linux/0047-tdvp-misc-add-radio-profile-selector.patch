+# SPDX-License-Identifier: GPL-2.0-only OR BSD-2-Clause
+%YAML 1.2
+---
+$id: http://devicetree.org/schemas/misc/vicliu,tdvp-radio-mux.yaml#
+$schema: http://devicetree.org/meta-schemas/core.yaml#
+
+title: T-Display K230 LR2021 and nRF9151 radio profile selector
+
+maintainers:
+  - T-Display K230 platform maintainers
+
+description: |
+  The T-Display K230 routes SoC IO5 both to the LR2021 LoRa reset input
+  and to the optional nRF9151 modem UART2 transmit signal. This device
+  selects exactly one pin profile and powers down the inactive radio.
+
+properties:
+  compatible:
+    const: vicliu,tdvp-radio-mux
+
+  pinctrl-names:
+    items:
+      - const: lora
+      - const: nrf9151
+
+  pinctrl-0: true
+
+  pinctrl-1: true
+
+  lora-enable-gpios:
+    maxItems: 1
+
+  lora-reset-gpios:
+    maxItems: 1
+
+  nrf9151-enable-gpios:
+    maxItems: 1
+
+required:
+  - compatible
+  - pinctrl-names
+  - pinctrl-0
+  - pinctrl-1
+  - lora-enable-gpios
+  - lora-reset-gpios
+  - nrf9151-enable-gpios
+
+additionalProperties: false
+
+examples:
+  - |
+    radio-mux {
+        compatible = "vicliu,tdvp-radio-mux";
+        pinctrl-names = "lora", "nrf9151";
+    };
+
+...
diff --git a/Documentation/ABI/testing/sysfs-platform-tdvp-radio-mux b/Documentation/ABI/testing/sysfs-platform-tdvp-radio-mux
new file mode 100644
--- /dev/null
+++ b/Documentation/ABI/testing/sysfs-platform-tdvp-radio-mux
@@ -0,0 +1,20 @@
+What:           /sys/devices/platform/*radio-mux/profile
+Date:           2026-08-11
+KernelVersion:  6.6
+Contact:        T-Display K230 platform maintainers
+Description:
+                Selects the exclusive physical radio profile on T-Display K230.
+
+                Reading returns one of:
+                    lora
+                    nrf9151
+
+                Writing "lora" selects the LR2021 profile,
+                powers down the nRF9151 modem, and keeps the LoRa radio powered
+                down and reset until its owning user-space service activates it.
+
+                Writing "nrf9151" routes IO5 and IO6 to UART2, holds the LoRa
+                radio off and in reset, and enables the optional nRF9151 modem.
+
+                A caller must stop the active radio service before changing this
+                attribute. The selector serializes profile changes in the driver.
