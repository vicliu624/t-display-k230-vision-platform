+static int canaan_panel_backlight_update_status(struct backlight_device *backlight)
+{
+	struct canaan_panel *panel = bl_get_data(backlight);
+	u16 brightness;
+	int ret = 0;
+
+	mutex_lock(&panel->lock);
+	if (!panel->prepared)
+		goto out;
+
+	brightness = backlight_get_brightness(backlight);
+	if (backlight->props.power != FB_BLANK_UNBLANK ||
+	    backlight->props.state & BL_CORE_FBBLANK)
+		brightness = 0;
+
+	ret = mipi_dsi_dcs_set_display_brightness_large(panel->dsi,
+						 brightness << 8);
+out:
+	mutex_unlock(&panel->lock);
+	return ret;
+}
+
+static const struct backlight_ops canaan_panel_backlight_ops = {
+	.update_status = canaan_panel_backlight_update_status,
+};
+
 static int panel_simple_xfer_dsi_cmd_seq(struct canaan_panel *panel,
