 #include <linux/delay.h>
 #include <linux/i2c.h>
+#include <linux/gpio/consumer.h>
 #include <linux/init.h>
 #include <linux/input.h>
 #include <linux/input/matrix_keypad.h>
@@ -259,6 +260,32 @@ static int tca8418_configure(struct tca8418_keypad *keypad_data,
 	return error;
 }
 
+static int tca8418_reset(struct device *dev)
+{
+	struct gpio_desc *reset_gpio;
+
+	/*
+	 * The optional descriptor uses the normal reset-gpios polarity rules:
+	 * logical one asserts reset and logical zero deasserts it.  T-Display
+	 * K230 wires this active-low, so this becomes the documented low/high
+	 * pulse without exposing GPIO numbering to userspace.
+	 */
+	reset_gpio = devm_gpiod_get_optional(dev, "reset", GPIOD_OUT_LOW);
+	if (IS_ERR(reset_gpio))
+		return dev_err_probe(dev, PTR_ERR(reset_gpio),
+				     "failed to get reset GPIO\n");
+
+	if (!reset_gpio)
+		return 0;
+
+	gpiod_set_value_cansleep(reset_gpio, 1);
+	usleep_range(10000, 11000);
+	gpiod_set_value_cansleep(reset_gpio, 0);
+	usleep_range(10000, 11000);
+
+	return 0;
+}
