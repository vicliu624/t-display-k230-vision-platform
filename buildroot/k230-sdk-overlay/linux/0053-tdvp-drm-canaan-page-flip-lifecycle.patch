diff --git a/drivers/gpu/drm/canaan/canaan_crtc.c b/drivers/gpu/drm/canaan/canaan_crtc.c
--- a/drivers/gpu/drm/canaan/canaan_crtc.c
+++ b/drivers/gpu/drm/canaan/canaan_crtc.c
@@ -73,18 +73,30 @@ static void canaan_crtc_atomic_disable(struct drm_crtc *crtc,
 {
 	struct canaan_crtc *canaan_crtc = to_canaan_crtc(crtc);
 	struct canaan_vo *vo = canaan_crtc->vo;
+	struct drm_pending_vblank_event *event;
 
 	DRM_DEBUG_DRIVER("Disable the CRTC:%d\n", crtc->base.id);
 	drm_crtc_vblank_off(crtc);
 	canaan_vo_disable_crtc(vo, canaan_crtc);
 
+	/*
+	 * A flip event queued by atomic_flush() holds a vblank reference. The
+	 * CRTC is being disabled, so no further VTTH interrupt can complete it.
+	 */
+	spin_lock_irq(&crtc->dev->event_lock);
+	event = canaan_crtc->event;
+	canaan_crtc->event = NULL;
+	if (event)
+		drm_crtc_send_vblank_event(crtc, event);
+
 	if (crtc->state->event && !crtc->state->active) {
-		spin_lock_irq(&crtc->dev->event_lock);
 		drm_crtc_send_vblank_event(crtc, crtc->state->event);
-		spin_unlock_irq(&crtc->dev->event_lock);
-
 		crtc->state->event = NULL;
 	}
+	spin_unlock_irq(&crtc->dev->event_lock);
+
+	if (event)
+		drm_crtc_vblank_put(crtc);
 }
 
 static void canaan_crtc_atomic_flush(struct drm_crtc *crtc,
@@ -93,18 +105,43 @@ static void canaan_crtc_atomic_flush(struct drm_crtc *crtc,
 	struct canaan_crtc *canaan_crtc = to_canaan_crtc(crtc);
 	struct canaan_vo *vo = canaan_crtc->vo;
 	struct drm_pending_vblank_event *event = crtc->state->event;
+	bool drop_vblank_ref = false;
+	int vblank_ret = 0;
 
 	DRM_DEBUG_DRIVER("Flush the configuration\n");
-	canaan_vo_flush_config(vo);
-
-	if (event) {
-		WARN_ON(drm_crtc_vblank_get(crtc) != 0);
-
-		spin_lock_irq(&crtc->dev->event_lock);
-		drm_crtc_arm_vblank_event(crtc, event);
-		spin_unlock_irq(&crtc->dev->event_lock);
-		crtc->state->event = NULL;
-	}
+	if (!event) {
+		canaan_vo_flush_config(vo);
+		return;
+	}
+
+	/* Keep a vblank reference before making the VO GO write visible. */
+	vblank_ret = drm_crtc_vblank_get(crtc);
+
+	/*
+	 * VO_REG_LOAD_CTL is a "go" register. Keep event_lock across the GO write
+	 * after publishing the event, so the VTTH IRQ cannot release its buffer
+	 * before this atomic update reaches the hardware. This open-codes the
+	 * event delivery instead of drm_crtc_arm_vblank_event().
+	 */
+	spin_lock_irq(&crtc->dev->event_lock);
+	if (vblank_ret == 0) {
+		if (WARN_ON(canaan_crtc->event)) {
+			/* Do not lose the new event or its vblank reference. */
+			drm_crtc_send_vblank_event(crtc, event);
+			drop_vblank_ref = true;
+		} else {
+			canaan_crtc->event = event;
+		}
+	} else {
+		/* The CRTC is no longer able to generate a vblank. */
+		drm_crtc_send_vblank_event(crtc, event);
+	}
+	crtc->state->event = NULL;
+	canaan_vo_flush_config(vo);
+	spin_unlock_irq(&crtc->dev->event_lock);
+
+	if (drop_vblank_ref)
+		drm_crtc_vblank_put(crtc);
 }
 
