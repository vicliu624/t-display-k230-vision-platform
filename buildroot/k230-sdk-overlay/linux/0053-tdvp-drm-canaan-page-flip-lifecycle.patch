+++ b/drivers/gpu/drm/canaan/canaan_vo.c
@@ -486,12 +486,38 @@ static irqreturn_t canaan_vo_irq_handler(int irq, void *dev_id)
 {
 	struct canaan_vo *vo = dev_id;
 	struct canaan_crtc *canaan_crtc = vo->canaan_crtc;
+	struct drm_crtc *crtc = &canaan_crtc->base;
+	struct drm_pending_vblank_event *event;
+	u32 status;
 
-	canaan_vo_write(vo, VO_DISP_IRQ_STATUS, 0xffffffff);
+	status = canaan_vo_read(vo, VO_DISP_IRQ_STATUS);
+	/*
+	 * This is a W1C status register. Write every asserted bit back rather
+	 * than filtering it through a guessed subset: an uncleared source can
+	 * retrigger the shared VO IRQ and starve the flip path.
+	 */
+	if (status == 0)
+		return IRQ_NONE;
 
-	// printk("canaan_vo_irq_handler---------------\n");
-	if (atomic_read(&vo->vsync_enabled))
-		drm_crtc_handle_vblank(&canaan_crtc->base);
+	canaan_vo_write(vo, VO_DISP_IRQ_STATUS, status);
+
+	/* IRQ1 is the only VO interrupt used as the vblank source. */
+	if (!(status & VO_DISP_IRQ1_STATUS) ||
+	    !atomic_read(&vo->vsync_enabled))
+		return IRQ_HANDLED;
+
+	drm_crtc_handle_vblank(crtc);
+
+	spin_lock(&crtc->dev->event_lock);
+	event = canaan_crtc->event;
+	if (event) {
+		canaan_crtc->event = NULL;
+		drm_crtc_send_vblank_event(crtc, event);
+	}
+	spin_unlock(&crtc->dev->event_lock);
+
+	if (event)
+		drm_crtc_vblank_put(crtc);
 
 	return IRQ_HANDLED;
 }
