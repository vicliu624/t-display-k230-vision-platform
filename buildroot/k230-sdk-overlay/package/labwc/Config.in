config BR2_PACKAGE_LABWC
	bool "labwc"
	depends on BR2_PACKAGE_WLROOTS
	depends on BR2_USE_MMU
	select BR2_PACKAGE_CAIRO
	select BR2_PACKAGE_CAIRO_PNG
	select BR2_PACKAGE_LIBGLIB2
	select BR2_PACKAGE_LIBINPUT
	select BR2_PACKAGE_LIBPNG
	select BR2_PACKAGE_LIBXML2
	select BR2_PACKAGE_PANGO
	select BR2_PACKAGE_PIXMAN
	select BR2_PACKAGE_WAYLAND_PROTOCOLS
	help
	  Labwc is the wlroots-based Wayland compositor used by the TDVP
	  user-space session. The pinned 0.8.4 release targets wlroots 0.18.

comment "labwc needs an MMU and wlroots"
	depends on !BR2_USE_MMU || !BR2_PACKAGE_WLROOTS
