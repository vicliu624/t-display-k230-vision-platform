+/*
+ * K230's vg_lite_blit() invokes a whole-allocation CPU-cache clean whenever
+ * source->memory is non-NULL. wlroots may call it once for every clip
+ * rectangle, and layer-shell clients commonly own a full-output ARGB texture
+ * while changing only a narrow band. Let precisely the first post-upload
+ * blit perform the vendor's proven clean; hide the CPU mapping for later
+ * clips and static frames. This does not depend on VG_LITE_CACHE: the locked
+ * K230 kernel currently implements that ioctl as a no-op. The GPU address and
+ * allocation handle remain intact, and source->memory is restored before
+ * returning so CPU uploads, readback and destruction retain their normal ABI.
+ */
+static vg_lite_error_t blit_cached_texture(struct wlr_vglite_render_pass *pass,
+		struct wlr_vglite_texture *texture, vg_lite_matrix_t *matrix,
+		vg_lite_blend_t blend, vg_lite_filter_t filter) {
+	void *source_memory = texture->source.memory;
+	if (source_memory == NULL) {
+		wlr_log(WLR_ERROR, "VGLite texture source has no CPU mapping");
+		return VG_LITE_INVALID_ARGUMENT;
+	}
+
+	bool source_cache_dirty = texture->source_cache_dirty;
+	if (!source_cache_dirty) {
+		/* The texture has no new CPU writes; suppress the redundant clean. */
+		texture->source.memory = NULL;
+	}
+	vg_lite_error_t error = vg_lite_blit(&pass->buffer->target, &texture->source,
+		matrix, blend, 0, filter);
+	texture->source.memory = source_memory;
+	if (error == VG_LITE_SUCCESS && source_cache_dirty) {
+		/* vg_lite_blit() has just cleaned this mapped source allocation once. */
+		texture->source_cache_dirty = false;
+		if (pass->diagnostics) {
+			pass->texture_cache_flushes++;
+		}
+	}
+	return error;
