+++ b/libopkg/solvers/internal/opkg_action.c
@@ -188,9 +188,10 @@
     int err = 0;
     pkg_vec_t *pkgs_to_upgrade = NULL;
     int r;
+    int combine = opkg_config->combine || num_pkgs != 1;
 
     if (num_pkgs) {
-        if (opkg_config->combine)
+        if (combine)
             pkgs_to_upgrade = pkg_vec_alloc();
 
         for (i = 0; i < num_pkgs; i++) {
@@ -209,7 +210,7 @@
