config BR2_PACKAGE_TDVP_VGLITE_ACCEPTANCE
	bool "tdvp-vglite-acceptance"
	depends on BR2_TOOLCHAIN_HAS_THREADS
	select BR2_PACKAGE_LIBDRM
	select BR2_PACKAGE_VG_LITE
	help
	  Install the bounded TDVP VGLite acceptance probe.

	  The probe is deliberately not a display diagnostic: it creates an
	  off-screen DRM dumb buffer, exports it as DMA-BUF, and renders into it
	  through VGLite. It never obtains DRM master, creates a framebuffer,
	  changes a mode, commits an atomic state, or flips a page. Run it as the
	  graphical login user before enabling VGLite inside wlroots.

comment "tdvp-vglite-acceptance needs a toolchain w/ threads"
	depends on !BR2_TOOLCHAIN_HAS_THREADS
