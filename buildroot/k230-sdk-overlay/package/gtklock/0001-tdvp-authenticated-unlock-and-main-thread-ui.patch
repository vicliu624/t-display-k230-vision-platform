+static gboolean window_pw_result(gpointer data) {
+	/* Runs on the main loop. No pointer to the original window is retained:
+	 * an output can disappear while PAM waits for unix_chkpwd. */
+	g_application_unmark_busy(G_APPLICATION(gtklock->app));
+	if(GPOINTER_TO_INT(data) == PW_SUCCESS) {
+		gtklock->authenticated = TRUE;
+		g_application_quit(G_APPLICATION(gtklock->app));
+		return G_SOURCE_REMOVE;
+	}
+	for(guint i = 0; i < gtklock->windows->len; ++i) {
+		struct Window *ctx = g_array_index(gtklock->windows, struct Window *, i);
+		window_set_busy(ctx, FALSE);
+		gtk_entry_set_text(GTK_ENTRY(ctx->input_field), "");
+		gtk_label_set_text(GTK_LABEL(ctx->error_label), _("Login failed"));
+	}
+	if(gtklock->focused_window)
+		gtk_entry_grab_focus_without_selecting(GTK_ENTRY(gtklock->focused_window->input_field));
 	return G_SOURCE_REMOVE;
 }
 
