diff --git a/src/gtklock.c b/src/gtklock.c
index 512b5ca..883f0c0 100644
--- a/src/gtklock.c
+++ b/src/gtklock.c
@@ -148,6 +148,9 @@ void gtklock_shutdown(struct GtkLock *gtklock) {
 		gtklock->idle_hide_source = 0;
 	}
 
+	/* SIGTERM / UI shutdown must leave the compositor locked. An active
+	 * lock cannot be destroyed without unlocking; let disconnect handle it. */
+	if(!gtklock->authenticated) return;
 	gtk_session_lock_lock_unlock_and_destroy(gtklock->lock);
 	gdk_display_sync(gdk_display_get_default());
 
