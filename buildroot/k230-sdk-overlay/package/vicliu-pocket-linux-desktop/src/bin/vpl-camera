#!/bin/sh
set -eu

if ! device="$(/usr/libexec/tdvp-camera-device)" || \
		! systemctl -q is-active tdvp-camera-isp.service; then
	exec /usr/bin/foot --title Camera -e sh -c \
		'echo "GC2093 camera is not ready. Check: journalctl -u tdvp-camera-modules -u tdvp-camera-isp"; read -r _'
fi

# Wayland preview must not take over DRM/display ownership.
# G_PARM is unsupported by this driver; completion PTS have been validated.
# Keep capture at 1080p, but convert/copy to a display-sized SHM preview. Do not
# retain the V4L2 MMAP frames in a threaded readahead queue after device close.
# Use -o-add: assigning -o would discard low-latency's fflags=+nobuffer.
exec /usr/bin/mpv --profile=low-latency --untimed --vo=wlshm \
	'--vf=lavfi=[scale=640:-2:flags=fast_bilinear,format=bgra]' \
	--demuxer-thread=no --demuxer-readahead-secs=0 \
	--demuxer-lavf-o-add=video_size=1920x1080 \
	--demuxer-lavf-o-add=input_format=nv12 "$@" \
	"av://v4l2:$device"
