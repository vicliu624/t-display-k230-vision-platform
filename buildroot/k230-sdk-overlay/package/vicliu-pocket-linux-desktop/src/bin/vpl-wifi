#!/bin/sh
set -eu

ssid="$(sudo /usr/local/libexec/vpl-desktopctl wifi-scan |
	/usr/bin/wofi --dmenu --prompt 'Wi-Fi network' --lines 8 || true)"
[ -n "$ssid" ] || exit 0

passphrase="$(printf '%s\\n' '' |
	/usr/bin/wofi --dmenu --password --prompt "Passphrase for $ssid" || true)"
[ -n "$passphrase" ] || exit 0

sudo /usr/local/libexec/vpl-desktopctl wifi-connect "$ssid" "$passphrase"
