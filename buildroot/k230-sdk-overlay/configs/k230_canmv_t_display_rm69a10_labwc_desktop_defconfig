BR2_TOOLCHAIN_EXTERNAL_CXX=y
BR2_TOOLCHAIN_EXTERNAL_FORTRAN=y
BR2_TOOLCHAIN_EXTERNAL_OPENMP=y
BR2_TARGET_OPTIMIZATION="-mcpu=c908v -mtune=c908 -mrvv-v0p10-compatible -mrvv-auto-vectorize"
BR2_DL_DIR="$(TOPDIR)/../../dl"
# Release candidates must be generated from one stable ext4 worktree/output
# location. This removes build timestamps and host identity from Buildroot,
# Linux, U-Boot, and rootfs artifacts where the upstream packages support it.
BR2_REPRODUCIBLE=y
BR2_TARGET_GENERIC_HOSTNAME="tdisplay-k230"
BR2_TARGET_GENERIC_ISSUE="T-Display K230 Labwc Desktop"
BR2_GENERATE_LOCALE="en_US.UTF-8"
# The Buildroot clear-text password path generates a new crypt salt per build.
# Keep the documented development password (tdvp), but provide a fixed SHA-256
# crypt value so the generated rootfs is byte-reproducible.
BR2_TARGET_GENERIC_ROOT_PASSWD="$$5$$tdvp-repro-2026$$oF1fY2harBx8EsEeKt.jshl8qujlwVIvSW8pUxsnZID"
BR2_INIT_SYSTEMD=y
BR2_TARGET_GENERIC_GETTY=y
BR2_TARGET_GENERIC_GETTY_PORT="ttyS0"
BR2_TARGET_GENERIC_GETTY_BAUDRATE_115200=y
BR2_ROOTFS_OVERLAY="board/canaan/k230-soc/rootfs_overlay"
BR2_ROOTFS_POST_BUILD_SCRIPT="board/tdvp/post-build.sh"
BR2_ROOTFS_POST_FAKEROOT_SCRIPT="board/tdvp/post-fakeroot.sh"
BR2_ROOTFS_POST_IMAGE_SCRIPT="board/tdvp/post-image.sh"
