BR2_PACKAGE_LIBCURL=y
BR2_PACKAGE_LIBCURL_CURL=y
BR2_PACKAGE_LIBCURL_OPENSSL=y
# GLib applications use this GIO module for TLS integration. It is required
# by the graphical network tooling; a general browser is delivered separately
# through the signed feed rather than expanding the base image.
BR2_PACKAGE_GLIB_NETWORKING=y
BR2_PACKAGE_OPKG=y
BR2_PACKAGE_OPKG_GPG_SIGN=y
BR2_PACKAGE_GNUPG2=y
