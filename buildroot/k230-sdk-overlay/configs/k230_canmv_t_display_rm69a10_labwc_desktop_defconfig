BR2_PACKAGE_NETWORK_MANAGER_CLI=y
BR2_PACKAGE_NM_CONNECTION_EDITOR=y
BR2_PACKAGE_WIRELESS_REGDB=y
# A desktop image needs the standard process-management utilities rather than
# forcing every integration script to reimplement pgrep/pkill using ps output.
BR2_PACKAGE_PROCPS_NG=y
BR2_PACKAGE_UTIL_LINUX=y
# Install the actual util-linux command set.  In particular this replaces the
# limited BusyBox fdisk with large-media-capable fdisk/sfdisk, which is needed
# to inspect and maintain full-size SD cards.
BR2_PACKAGE_UTIL_LINUX_BINARIES=y
BR2_PACKAGE_UTIL_LINUX_RFKILL=y
# The image contains only boot and root. On first boot tdvp-expand-rootfs
# grows GPT partition 2 (preserving its U-Boot PARTUUID), reboots once, and
# expands ext4. No /data partition is created.
BR2_PACKAGE_GPTFDISK=y
BR2_PACKAGE_GPTFDISK_SGDISK=y
BR2_PACKAGE_E2FSPROGS=y
BR2_PACKAGE_E2FSPROGS_RESIZE2FS=y
