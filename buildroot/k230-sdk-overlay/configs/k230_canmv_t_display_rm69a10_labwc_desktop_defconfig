BR2_riscv=y
BR2_RISCV_ISA_RVC=y
BR2_RISCV_ISA_RVV=y
BR2_TOOLCHAIN_EXTERNAL=y
BR2_TOOLCHAIN_EXTERNAL_CUSTOM=y
BR2_TOOLCHAIN_EXTERNAL_PATH="/opt/toolchain/Xuantie-900-gcc-linux-6.6.0-glibc-x86_64-V3.0.2/"
BR2_TOOLCHAIN_EXTERNAL_CUSTOM_PREFIX="riscv64-unknown-linux-gnu"
BR2_TOOLCHAIN_EXTERNAL_HEADERS_6_6=y
BR2_TOOLCHAIN_EXTERNAL_CUSTOM_GLIBC=y
# BR2_TOOLCHAIN_EXTERNAL_INET_RPC is not set
BR2_TOOLCHAIN_EXTERNAL_CXX=y
BR2_TOOLCHAIN_EXTERNAL_FORTRAN=y
BR2_TOOLCHAIN_EXTERNAL_OPENMP=y
BR2_TARGET_OPTIMIZATION="-mcpu=c908v -mtune=c908 -mrvv-v0p10-compatible -mrvv-auto-vectorize"
BR2_DL_DIR="$(TOPDIR)/../../dl"
# Release candidates must be generated from one stable ext4 worktree/output
# location. This removes build timestamps and host identity from Buildroot,
# Linux, U-Boot, and rootfs artifacts where the upstream packages support it.
BR2_REPRODUCIBLE=y
# Several desktop and media dependencies contain large C/C++ or Rust build
# graphs. The automatic value expands to every host CPU (17 on the release
# builder) and can cause the kernel to kill compiler processes. Keep all
# Buildroot package backends within the validated four-job ceiling;
# TDVP_BUILD_JOBS uses the same ceiling.
BR2_JLEVEL=4
BR2_TARGET_GENERIC_HOSTNAME="tdisplay-k230"
BR2_TARGET_GENERIC_ISSUE="T-Display K230 Labwc Desktop"
BR2_GENERATE_LOCALE="en_US.UTF-8"
# The Buildroot clear-text password path generates a new crypt salt per build.
# Keep the documented development password (tdvp), but provide a fixed SHA-256
# crypt value so the generated rootfs is byte-reproducible.
BR2_TARGET_GENERIC_ROOT_PASSWD="$$5$$tdvp-repro-2026$$oF1fY2harBx8EsEeKt.jshl8qujlwVIvSW8pUxsnZID"
BR2_INIT_SYSTEMD=y
BR2_TARGET_GENERIC_GETTY=y
BR2_TARGET_GENERIC_GETTY_PORT="ttyS0"
BR2_TARGET_GENERIC_GETTY_BAUDRATE_115200=y
BR2_ROOTFS_OVERLAY="board/canaan/k230-soc/rootfs_overlay"
BR2_ROOTFS_POST_BUILD_SCRIPT="board/tdvp/post-build.sh"
BR2_ROOTFS_POST_FAKEROOT_SCRIPT="board/tdvp/post-fakeroot.sh"
BR2_ROOTFS_POST_IMAGE_SCRIPT="board/tdvp/post-image.sh"
BR2_LINUX_KERNEL=y
BR2_LINUX_KERNEL_CUSTOM_GIT=y
BR2_LINUX_KERNEL_CUSTOM_REPO_URL="https://github.com/ruyisdk/linux-xuantie-kernel.git"
BR2_LINUX_KERNEL_CUSTOM_REPO_VERSION="7d4e1f444f461dbe3833bd99a4640e7b6c2cd529"
BR2_LINUX_KERNEL_DEFCONFIG="k230"
BR2_LINUX_KERNEL_CONFIG_FRAGMENT_FILES="board/canaan/k230-soc/fragment/linux.fragment board/canaan/k230-soc/fragment/linux.led_btn board/tdvp/fragment/linux.keyboard board/tdvp/fragment/linux.touch board/tdvp/fragment/linux.hardware"
BR2_LINUX_KERNEL_DTS_SUPPORT=y
BR2_LINUX_KERNEL_INTREE_DTS_NAME="canaan/k230-canmv-rm69a10 canaan/k230-canmv-v3"
BR2_LINUX_KERNEL_NEEDS_HOST_OPENSSL=y
# BR2_PACKAGE_VO_INIT is not set
BR2_PACKAGE_BUSYBOX_CONFIG_FRAGMENT_FILES="board/canaan/k230-soc/fragment/busybox.fragment"
BR2_PACKAGE_LINUX_TOOLS_GPIO=y
BR2_PACKAGE_BUSYBOX_SHOW_OTHERS=y
BR2_PACKAGE_AIC8800=y
BR2_PACKAGE_RTL8189FS=y
BR2_PACKAGE_LIBMMZ=y
BR2_PACKAGE_LIBNNCASE=y
BR2_PACKAGE_AI2D_KPU=y
BR2_PACKAGE_VVCAM=y
BR2_PACKAGE_VVCAM_DEF_SENSOR="ov5647"
