BR2_PACKAGE_LIBNMA=y
BR2_PACKAGE_PULSEAUDIO=y
BR2_PACKAGE_PULSEAUDIO_DAEMON=y
# Standard desktop event sounds: wfplug-volumepulse uses libcanberra's
# PulseAudio backend and the Freedesktop sound theme, not a bespoke player.
BR2_PACKAGE_LIBCANBERRA=y
BR2_PACKAGE_SOUND_THEME_FREEDESKTOP=y
