# explicit so the rootfs is a reproducible part of the SD-card contract.
BR2_TARGET_ROOTFS_EXT2_MKFS_OPTIONS="-O ^64bit -U 6ed17b77-cd22-52f2-ae36-1fdbe5d476b7 -E hash_seed=4cf1e2c3-fd06-5a49-a511-89041a8a1b98"
