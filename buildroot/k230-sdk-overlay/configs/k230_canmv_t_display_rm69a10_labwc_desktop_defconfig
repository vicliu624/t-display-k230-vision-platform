BR2_PACKAGE_LIBGTK3_WAYLAND=y
BR2_PACKAGE_GTK_LAYER_SHELL=y
BR2_PACKAGE_GTKMM3=y
BR2_PACKAGE_LIBFM_EXTRA=y
BR2_PACKAGE_LIBMENU_CACHE=y
BR2_PACKAGE_LIBFM=y
BR2_PACKAGE_PCMANFM=y
# A general browser is intentionally not part of the first base image. The
